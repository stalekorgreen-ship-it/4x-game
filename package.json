{
  "name": "poyas-4x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node tests/sim.mjs",
    "test:long": "node tests/long.mjs && node tests/laws.mjs",
    "check": "tsc --noEmit",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "main": "electron/main.cjs",
  "productName": "Пояс 4X",
  "description": "Пояс 4X — космическая стратегия",
  "author": "Sanechka",
  "build": {
    "appId": "ru.sanechka.poyas4x",
    "productName": "Poyas4X",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "asar": true
  }
}
function makeDmg(l,i){let sd=100+i*13;const r=()=>{sd=(sd*16807)%2147483647;return sd/2147483647};const n=l===1?9:26,hits=[];for(let k=0;k<n;k++)hits.push({f:.1+.85*r(),v:r()<.75?r()*3.6:r()*6,r:.022+.035*r(),sev:l===1?.3+.5*r():.5+.5*r()});const tur=[];for(let k=0;k<12;k++)tur.push(l===1?.35+.65*r():r()*.6);return{hits,tur,mod:l===1?{radar:.55,eng:.3,cab:.4,tank:.4}:{radar:.95,eng:.7,cab:.85,tank:.8}}}
specs.forEach((s,i)=>{s.seed=11+i*7;s.col=COLS[i];s.id=IDS[i];const m=ship(s,DL?makeDmg(DL,i):null);m.position.set((i%2?1:-1)*11.5,0,(Math.floor(i/2)-2)*10);m.rotation.y=-.55;sc.add(m)});
